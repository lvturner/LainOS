[Unit]
Description=Camofox Browser Server
After=network.target

[Service]
Type=simple
User=lainos
Environment=HOME=/home/lainos
Environment=PATH=/home/lainos/.nix-profile/bin:/home/lainos/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NIX_PATH=nixpkgs=/home/lainos/.nix-defexpr/channels/nixpkgs
Environment=NIX_SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
Environment=NODE_ENV=production
Environment=CAMOFOX_PORT=9377
Environment=CAMOFOX_CRASH_REPORT_ENABLED=false
ExecStart=/usr/bin/node --max-old-space-size=128 /usr/lib/camofox/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
